{
  "expo": {
    "name": "Yakıt Radar",
    "slug": "pompa-metre",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pompametre",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#101010",
          "dark": {
            "backgroundColor": "#101010"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4C8DFF",
          "defaultChannel": "fuel-alerts"
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakıt Radar, bulunduğun ilin yakıt fiyatını göstermek için konumunu yalnızca cihazında kullanır.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pompametre.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yakıt Radar, bulunduğun ilin yakıt fiyatını göstermek için konumunu yalnızca cihazında kullanır."
      }
    },
    "android": {
      "package": "com.pompametre.app",
      "versionCode": 13,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101010"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "91a0e2a4-5ebf-484f-aaf2-112efa893c35"
      }
    },
    "owner": "ekoteko12"
  }
}
