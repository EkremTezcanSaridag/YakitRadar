# Supabase Configuration
# Your Supabase project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key for client-side access
SUPABASE_KEY=your-anon-key-here

# Supabase service role key for server-side admin operations (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Model Configuration
# Google Gemini API key for market analysis (optional, falls back to Groq)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Groq API key for market analysis (optional, falls back to rule-based analysis)
GROQ_API_KEY=your-groq-api-key-here

# Groq model to use (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Notification Configuration
# Minimum price change threshold for sending notifications (in TL)
NOTIFICATION_MIN_CHANGE=0.01

# Maximum reasonable price change to prevent false alerts (in TL)
MAX_REASONABLE_PRICE_CHANGE=8.0

# News feed maximum age in hours for market analysis
NEWS_MAX_AGE_HOURS=48

# Test Notification (for GitHub Actions workflow_dispatch)
# Set to 'true' to send a test notification
SEND_TEST_NOTIFICATION=false

# Installation ID for test notifications
TEST_NOTIFICATION_INSTALLATION_ID=

# Scraper Configuration (optional, for rate limiting)
# Delay between HTTP requests in seconds
SCRAPER_RATE_LIMIT_DELAY=1.0

# Request timeout in seconds
SCRAPER_REQUEST_TIMEOUT=30

# Maximum retry attempts for failed requests
SCRAPER_MAX_RETRIES=3

# Exponential backoff base delay in seconds
SCRAPER_RETRY_BASE_DELAY=2.0
